+ACK=BASE|{'request_start_us','source_boots'}
+SCAN=ACK|{'scan_id','start_us','end_us','duration_us','raw_angles_rad','axis_status'}
+REGIONS=(3,6,9,9,7,7)
+
+
+def envelope(payload):
