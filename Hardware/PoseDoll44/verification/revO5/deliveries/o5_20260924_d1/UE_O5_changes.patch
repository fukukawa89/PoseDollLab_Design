+    TestTrue(TEXT("Evicted IDs remain strict"),R.Route(TEXT("0"),41)==EStaticRoute::Unexpected);
+    R.Reset();TestTrue(TEXT("Reconnect clears old session"),R.Route(TEXT("39"),41)==EStaticRoute::Unexpected);
