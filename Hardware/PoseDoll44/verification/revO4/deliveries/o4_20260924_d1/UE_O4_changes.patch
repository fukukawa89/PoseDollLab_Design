+def test_tcp_request_and_fragmentation():
+    p=profile();s=StaticSensorServer(p,0);s.faults.fragment=True;s.start();port=s._socket.getsockname()[1]
+    try:
+        with socket.create_connection(('127.0.0.1',port),timeout=2) as c:
